PORT=4000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema_notas

# Cadena larga y aleatoria; cambiarla invalida todas las sesiones
JWT_SECRET=
JWT_EXPIRA=8h

# En el servidor: production. Con production, db:setup se niega a borrar la base
NODE_ENV=development
# Si la API está detrás de Nginx u otro proxy
# TRUST_PROXY=1

# Correo para notificaciones (opcional; sin esto solo hay avisos dentro de la plataforma)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USUARIO=notificaciones@colegio.edu.co
# SMTP_CLAVE=
# SMTP_REMITENTE="IEMM Plataforma <notificaciones@colegio.edu.co>"

# Dirección pública del sitio (para los enlaces de los correos y el QR del carnet)
URL_PUBLICA=http://localhost:5173

# Copias de seguridad (npm run db:respaldo)
# MYSQLDUMP=/usr/bin/mysqldump
# CARPETA_RESPALDOS=/var/respaldos/iemm
# RESPALDOS_A_CONSERVAR=30
